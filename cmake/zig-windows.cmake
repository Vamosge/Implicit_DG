get_filename_component(GSX_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(ENV{ZIG_GLOBAL_CACHE_DIR} "${GSX_ROOT}/build/.zig-cache/global")
set(ENV{ZIG_LOCAL_CACHE_DIR} "${GSX_ROOT}/build/.zig-cache/local")
set(GSX_ZIG "${GSX_ROOT}/.tools/zig/zig.exe")
if(NOT EXISTS "${GSX_ZIG}")
  file(GLOB GSX_ZIG_NPM
    "${GSX_ROOT}/.tools/zig-package/node_modules/.pnpm/@zigc+win32-x64@*/node_modules/@zigc/win32-x64/bin/zig.exe")
  list(LENGTH GSX_ZIG_NPM GSX_ZIG_NPM_COUNT)
  if(GSX_ZIG_NPM_COUNT GREATER 0)
    list(GET GSX_ZIG_NPM 0 GSX_ZIG)
    file(GLOB GSX_ZIG_LIB_NPM
      "${GSX_ROOT}/.tools/zig-package/node_modules/.pnpm/@zigc+lib@*/node_modules/@zigc/lib")
    list(LENGTH GSX_ZIG_LIB_NPM GSX_ZIG_LIB_NPM_COUNT)
    if(GSX_ZIG_LIB_NPM_COUNT GREATER 0)
      list(GET GSX_ZIG_LIB_NPM 0 GSX_ZIG_LIB)
      set(ENV{ZIG_LIB_DIR} "${GSX_ZIG_LIB}")
      set(GSX_ZIG_LAUNCHER
        "${CMAKE_COMMAND};-E;env;ZIG_LIB_DIR=${GSX_ZIG_LIB};ZIG_GLOBAL_CACHE_DIR=${GSX_ROOT}/build/.zig-cache/global;ZIG_LOCAL_CACHE_DIR=${GSX_ROOT}/build/.zig-cache/local")
      set(CMAKE_C_COMPILER_LAUNCHER "${GSX_ZIG_LAUNCHER}" CACHE STRING "" FORCE)
      set(CMAKE_CXX_COMPILER_LAUNCHER "${GSX_ZIG_LAUNCHER}" CACHE STRING "" FORCE)
    endif()
  endif()
endif()
if(NOT EXISTS "${GSX_ZIG}")
  message(FATAL_ERROR "Zig was not found. Run tools/bootstrap-build-tools.ps1 first.")
endif()

set(CMAKE_C_COMPILER "${GSX_ZIG}" CACHE FILEPATH "" FORCE)
set(CMAKE_C_COMPILER_ARG1 cc CACHE STRING "" FORCE)
set(CMAKE_CXX_COMPILER "${GSX_ZIG}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER_ARG1 c++ CACHE STRING "" FORCE)
set(GSX_ZIG_CACHE_LAUNCHER
  "${CMAKE_COMMAND};-E;env;ZIG_GLOBAL_CACHE_DIR=${GSX_ROOT}/build/.zig-cache/global;ZIG_LOCAL_CACHE_DIR=${GSX_ROOT}/build/.zig-cache/local")
set(CMAKE_C_COMPILER_LAUNCHER "${GSX_ZIG_CACHE_LAUNCHER}" CACHE STRING "" FORCE)
set(CMAKE_CXX_COMPILER_LAUNCHER "${GSX_ZIG_CACHE_LAUNCHER}" CACHE STRING "" FORCE)
set(CMAKE_C_LINKER_LAUNCHER "${GSX_ZIG_CACHE_LAUNCHER}" CACHE STRING "" FORCE)
set(CMAKE_CXX_LINKER_LAUNCHER "${GSX_ZIG_CACHE_LAUNCHER}" CACHE STRING "" FORCE)
set(CMAKE_AR "${GSX_ZIG}" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${GSX_ZIG}" CACHE FILEPATH "" FORCE)
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_COMMAND> -E env ZIG_LIB_DIR=$ENV{ZIG_LIB_DIR} ZIG_GLOBAL_CACHE_DIR=$ENV{ZIG_GLOBAL_CACHE_DIR} ZIG_LOCAL_CACHE_DIR=$ENV{ZIG_LOCAL_CACHE_DIR} <CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_COMMAND> -E env ZIG_LIB_DIR=$ENV{ZIG_LIB_DIR} ZIG_GLOBAL_CACHE_DIR=$ENV{ZIG_GLOBAL_CACHE_DIR} ZIG_LOCAL_CACHE_DIR=$ENV{ZIG_LOCAL_CACHE_DIR} <CMAKE_RANLIB> ranlib <TARGET>")
set(CMAKE_CXX_ARCHIVE_CREATE "${CMAKE_C_ARCHIVE_CREATE}")
set(CMAKE_CXX_ARCHIVE_FINISH "${CMAKE_C_ARCHIVE_FINISH}")
set(CMAKE_MAKE_PROGRAM "${GSX_ROOT}/.tools/ninja/ninja.exe" CACHE FILEPATH "" FORCE)
